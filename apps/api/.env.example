# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vo_dev?schema=public
# Public URL of the web app (used in emails and CORS)
WEB_ORIGIN=http://localhost:5173
# Public URL of this API (used for SSO redirect URIs)
API_ORIGIN=http://localhost:4000

# ---- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32-byte key, base64. Encrypts TOTP secrets and SSO tokens at rest.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=14

# ---- Login protection ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Requests per minute per IP on login / forgot / reset endpoints
AUTH_RATE_LIMIT_PER_MIN=10

# ---- Email (leave SMTP_HOST empty in dev to print emails to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Virtual Office <no-reply@example.com>"

# ---- SSO (optional; a provider is enabled when its client id is set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "organizations" for work accounts only, or your tenant id
MICROSOFT_TENANT=organizations

# Set to 1 behind a single reverse proxy so client IPs are logged correctly.
# Not needed with ORIGIN_SECRET (the Vercel setup), which reads the client IP itself.
TRUST_PROXY=0

# ---- Vercel proxy (production) ----
# Same value as ORIGIN_SECRET in the Vercel project. When set, the API refuses any
# request that did not come through Vercel. Generate: openssl rand -base64 48
ORIGIN_SECRET=

# Host biometric terminals and the sync agent connect to. On Railway it defaults to the
# service's public domain; set this only if you give the API a custom domain.
DEVICE_HOST=
