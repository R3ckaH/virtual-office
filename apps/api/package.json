{
  "name": "@vo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only src/db/migrate.ts",
    "db:seed": "ts-node --transpile-only src/db/seed.ts",
    "db:reset": "ts-node --transpile-only src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:seed:demo": "ts-node --transpile-only src/db/seed-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@vo/shared": "workspace:*",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "jose": "5.10.0",
    "nodemailer": "7.0.9",
    "otplib": "12.0.1",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ua-parser-js": "1.0.41",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.8",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "@types/ua-parser-js": "0.7.39",
    "drizzle-kit": "0.31.11",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
